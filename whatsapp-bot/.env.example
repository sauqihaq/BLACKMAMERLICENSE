# Salin ke .env. File .env tidak boleh di-commit.
WEBSITE_URL=https://blackmamerlicense.vercel.app
# Nomor admin terpisah dari nomor WhatsApp Business yang ditautkan.
ADMIN_WA_NUMBER=6281234567890
# Opsional: file gambar QRIS milik toko (PNG/JPG). Jangan pernah taruh di folder public.
PAYMENT_QR_PATH=
# Opsional: jika Chromium memakai jalur khusus (mis. /usr/bin/chromium)
CHROME_EXECUTABLE_PATH=
# Opsional: simpan data di volume persisten pada server
BOT_DATA_DIR=./.bot-data
BOT_SESSION_DIR=./.wwebjs_auth
